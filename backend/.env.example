# Copy to .env.local and run: npx tsx --env-file=.env.local watch src/server.ts
# Production gets these from EC2 user data (infra/modules/compute).
# See README.md "Configuration" for every variable.
PORT=8000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
PWA_ORIGINS=http://localhost:5173
PAYMENT_RETURN_URL=http://localhost:5173/
AUTH_TEST_MODE=true
SEED_DEMO_ACCOUNTS=true
# AWS-only (leave unset locally): DB_HOST, DB_NAME, DB_SECRET_ARN, DB_CA_FILE, JWT_SECRET_ARN,
# SMS_SECRET_ARN, PHOTO_BUCKET, VOTEX_SECRET_ARN, ADMIN_SEED_SECRET_ARN
