# AgroConnect API — environment reference.
# Copy to .env for local work. Secrets are referenced by ARN; the app fetches their values at runtime.
# Nothing here is a real secret. See backend/README.md for the same table.

# --- Runtime -----------------------------------------------------------------
PORT=8000
# info | debug | warn | error | silent. Defaults to info (silent under test).
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# Local/proxy: a full connection string. Production uses DB_HOST + DB_SECRET_ARN instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agroconnect
# RDS host (host:port) and the RDS-managed master secret ({ username, password }).
DB_HOST=
DB_NAME=agroconnect
DB_SECRET_ARN=
# Path to the RDS CA bundle; required with DB_HOST so the TLS connection is verified.
DB_CA_FILE=

# --- Application -------------------------------------------------------------
# Comma-separated browser origins allowed by CORS.
PWA_ORIGINS=http://localhost:5173
# Return sign-in codes in responses and skip SMS. Must be false in production.
AUTH_TEST_MODE=false
# Seed the documented demo accounts. Their passwords are public: never on real data.
SEED_DEMO_ACCOUNTS=false

# --- AWS ---------------------------------------------------------------------
AWS_REGION=af-south-1
# RS256 signing key: { "private_key_pem": "<PKCS#8>" }. Unset: a throwaway key each restart.
JWT_SECRET_ARN=
# SMS: { "nalo_key", "nalo_sender_id" } (tried first) and/or Arkesel { "api_key", "sender_id", "sandbox"? } (fallback).
SMS_SECRET_ARN=
# Private S3 bucket for photos. Unset: in-memory storage, lost on restart.
PHOTO_BUCKET=

# --- votex365 payments -------------------------------------------------------
# { "api_key", "webhook_secret" }. Unset: every payment is simulated.
VOTEX_SECRET_ARN=
VOTEX_BASE_URL=https://utilities.votex365.com/api/v1/partner
PAYMENT_RETURN_URL=http://localhost:5173/

# --- First admin -------------------------------------------------------------
# { "login_id", "name", "phone", "password" } for seeding the first admin account.
ADMIN_SEED_SECRET_ARN=
