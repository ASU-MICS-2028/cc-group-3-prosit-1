# Where the PWA sends farmer registrations and photos.
VITE_API_URL=https://api.agroconnect.space

# Where people sign in. Leave unset to use VITE_API_URL.
# Until auth-service exists, point this at the mock (npm run mock). A hosted PWA can only call
# https:// addresses, so the mock then needs an HTTPS tunnel.
VITE_AUTH_URL=http://localhost:4000

# Where the admin and coordinator dashboards load from. Leave unset to use VITE_AUTH_URL.
# VITE_ADMIN_URL=

# Where the Wallet talks to (payments and loan requests). Leave unset to use VITE_API_URL.
# VITE_PAYMENTS_URL=

# Where crop checks and produce listings talk to. Leave unset to use VITE_ADMIN_URL.
# VITE_ADVICE_URL=
# VITE_LISTINGS_URL=
